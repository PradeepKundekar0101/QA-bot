# Which vendor backs every LLM call: "anthropic" (default) or "sarvam"
QA_PILOT_LLM_PROVIDER=anthropic

# --- provider: anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
QA_PILOT_MODEL=claude-opus-5

# --- provider: sarvam (https://sarvam.ai) ---
SARVAM_API_KEY=sk_...
# QA_PILOT_SARVAM_MODEL=sarvam-105b
# SARVAM_BASE_URL=https://api.sarvam.ai/v1

QA_PILOT_HEADLESS=1
QA_PILOT_API_PORT=4000
# Trackers (Linear, Jira) connect through Composio's OAuth: https://platform.composio.dev
COMPOSIO_API_KEY=ak_...
# Optional: reuse specific Composio auth configs instead of the ones qa-pilot creates on first use
# COMPOSIO_LINEAR_AUTH_CONFIG_ID=ac_...
# COMPOSIO_JIRA_AUTH_CONFIG_ID=ac_...
# Where the browser can reach the API, for the OAuth callback
QA_PILOT_API_ORIGIN=http://localhost:4000

# --- storage ---
# MongoDB Atlas connection string (MONGO_URI is accepted too)
QA_PILOT_MONGO_URL=mongodb+srv://...
# QA_PILOT_MONGO_DB=qa_pilot
# Keep everything in the API process instead, for a local demo; lost on restart
# QA_PILOT_STORE=memory

# --- payments: Pine Labs Online hosted checkout (https://www.pinelabs.com/docs/online-payments) ---
# Without these the first run is still free and paid checkout answers 503.
# PINELABS_CLIENT_ID=...
# PINELABS_CLIENT_SECRET=...
# Base64 webhook secret from the Pine Labs dashboard; the webhook URL is <API_ORIGIN>/webhooks/pinelabs
# PINELABS_WEBHOOK_SECRET=...
# Defaults to the UAT sandbox, https://pluraluat.v2.pinepg.in
# PINELABS_BASE_URL=https://api.pluralpay.in

# --- defect-triage agent on AgenticOrg (https://docs.agenticorg.ai) ---
# Bearer token the agent uses to reach qa-pilot's MCP tools at <API_ORIGIN>/mcp; unset turns /mcp off
# QA_PILOT_AGENT_TOKEN=...
# Starts the agent when a run holds candidate defects; unset means the owner rules in the app only
# AGENTICORG_BASE_URL=https://app.agenticorg.ai
# AGENTICORG_API_KEY=...
# AGENTICORG_AGENT_ID=...
# AGENTICORG_TASKS_PATH=/api/v1/a2a/tasks
# AGENTICORG_AUTH_HEADER=authorization
